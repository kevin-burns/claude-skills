{
  "defaults": {
    "window": 14,
    "contact": "",
    "exclude_company": [
      "randstad",
      "hays"
    ],
    "exclude_title": [
      "recruiter",
      "werkstudent",
      "praktikant",
      "intern"
    ]
  },
  "lanes": [
    {
      "name": "platform",
      "label": "Platform",
      "match": "\\b(platform|infrastructure|devops|cloud|systems|reliability)\\s*(engineer|architect|lead|manager)\\b|\\bsre\\b|\\bdevops\\b|terragrunt|landing zone|finops",
      "match_in": "title"
    },
    {
      "name": "em",
      "label": "EM",
      "match": "engineering manager|tech lead|team lead|head of engineering|director of engineering",
      "match_in": "title"
    },
    {
      "name": "fde",
      "label": "FDE",
      "match": "forward deployed|solutions engineer|solutions architect|customer engineer",
      "match_in": "title"
    },
    {
      "name": "ai",
      "label": "AI",
      "match": "\\b(ai|ml)\\s*(engineer|scientist|architect|lead)\\b|machine learning engineer|\\bllm\\b|agentic|\\bmcp\\b|\\brag\\b|generative ai|applied (ai|ml)",
      "match_in": "title"
    }
  ],
  "highlight": [
    "terragrunt",
    "finops",
    "landing zone",
    "multi-account",
    "agentic",
    "mcp",
    "cloud governance"
  ],
  "sources": {
    "arbeitnow": {
      "enabled": true
    },
    "jobicy": {
      "enabled": true
    },
    "remotive": {
      "enabled": true
    },
    "remoteok": {
      "enabled": true
    },
    "nomads": {
      "enabled": true
    },
    "4dayweek": {
      "enabled": true
    },
    "wwr": {
      "enabled": true
    },
    "pythonorg": {
      "enabled": true
    }
  }
}
