# Local Claude config
.claude

# OS / editor cruft
.DS_Store
*.swp

# Eval + benchmark build artifacts (skill-creator workspaces)
*-workspace/
clear-and-human-workspace
hook-and-human-workspace
*-review*.html

# Browser-driver scratch artifacts (playwright-cli snapshots, etc.)
.playwright-cli/

# Packaged skill archives
*.zip
*.skill

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local secrets / context (never publish)
WRITING_CONTEXT.local.md
.env
.env.*

# Local design specs / brainstorming output (kept out of the public repo)
docs/superpowers/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local beads issue tracker (kept private, not published)
.beads/

# Personal voice profile — the blank template lives in clear-and-human/
/WRITING_CONTEXT.md

# Wrangler local state. Carries the Cloudflare account id and email, and (when a
# cf.json is present) the machine geolocation, ISP, ASN and TLS fingerprints. Created
# here by running a wrangler command from this directory; not needed by this repo.
.wrangler/
.dev.vars

# beads gate lock, local only
.beads.gate.lock

# Prismor agent-registry state: a machine-local last_seen timestamp, regenerated
# on every run. Nothing reads it across machines.
.prismor/

# Skill publishing runbook. LOCAL ONLY -- it names internal sequencing, token
# handling and client-work context, and this repo is PUBLIC. Same reasoning as
# transcribe-summarize/.gitignore:22. Untracked is the guarantee: CI checks out
# only tracked files, and the mirror builder builds from a CI checkout, so a
# file that is not tracked cannot reach a published repo either.
/RUNBOOK.md
