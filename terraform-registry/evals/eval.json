{
  "tool": "terraform-registry/registry_helper.py",
  "description": "Offline/deterministic behavioral eval. Runs the CLI with --offline against frozen registry payloads in fixtures/cache to prove: provider-agnostic parsing (aws/google/azurerm via the same code), field projection + name filter, a provenance-stamped JSON envelope, and structured errors with correct exit codes. No network.",
  "cache_dir": "fixtures/cache",
  "cases": [
    {
      "id": "search-aws",
      "argv": ["--offline", "--format", "json", "search", "vpc", "--provider", "aws", "--limit", "5"],
      "expect": { "exit": 0, "ok": true, "command": "search", "min_count": 1,
                  "all_modules_provider": "aws", "source_kind": "registry_module_api", "cached": true }
    },
    {
      "id": "inspect-google",
      "argv": ["--offline", "--format", "json", "inspect-module", "terraform-google-modules/network/google"],
      "expect": { "exit": 0, "ok": true, "command": "inspect-module", "provider": "google",
                  "min_inputs": 2, "min_outputs": 2, "source_kind": "registry_module_api" }
    },
    {
      "id": "inspect-azurerm-filter-fields",
      "argv": ["--offline", "--format", "json", "inspect-module", "Azure/avm-res-keyvault-vault/azurerm",
               "--filter", "name~location", "--fields", "inputs"],
      "expect": { "exit": 0, "ok": true, "provider": "azurerm",
                  "inputs_all_contain": "location", "inputs_count": 1,
                  "absent_keys": ["outputs", "versions"] }
    },
    {
      "id": "offline-miss-error",
      "argv": ["--offline", "--format", "json", "search", "no-such-cached-query"],
      "expect": { "exit": 1, "ok": false, "error_code": 1 }
    },
    {
      "id": "inspect-resource-missing-schema",
      "argv": ["--offline", "--format", "json", "inspect-resource", "google_storage_bucket", "--provider", "google"],
      "expect": { "exit": 1, "ok": false, "error_code": 1 },
      "note": "No cached terraform schema in fixtures -> must fail cleanly pointing to refresh-schema, NOT crash. Module ops (search/inspect-module) need no terraform at all; only resource-schema ops do, and they degrade gracefully."
    },
    {
      "id": "stale-latest-refetches",
      "env": {"https_proxy": "http://127.0.0.1:9", "HTTPS_PROXY": "http://127.0.0.1:9", "no_proxy": "", "NO_PROXY": ""},
      "argv": ["--format", "json", "inspect-module", "terraform-google-modules/network/google"],
      "expect": {"exit": 3, "ok": false, "error_code": 3},
      "note": "wihl #1. Unversioned path cached 2026-06-11 is older than the 24h TTL, so the CLI must go to the network (a dead proxy here, same host so the cache key matches) instead of serving a stale 'latest'."
    },
    {
      "id": "versioned-stays-cached",
      "env": {"https_proxy": "http://127.0.0.1:9", "HTTPS_PROXY": "http://127.0.0.1:9", "no_proxy": "", "NO_PROXY": ""},
      "argv": ["--max-age-hours", "0", "--format", "json", "inspect-module", "terraform-aws-modules/eks/aws/21.30.2"],
      "expect": {"exit": 0, "ok": true, "cached": true, "warnings_not_contain": "cache age"},
      "note": "wihl #1 negative control. A versioned path is immutable: served from cache even with --max-age-hours 0, never refetched (a dead proxy makes any fetch fail)."
    },
    {
      "id": "offline-stale-warns",
      "argv": ["--offline", "--format", "json", "inspect-module", "terraform-google-modules/network/google"],
      "expect": {"exit": 0, "ok": true, "cached": true, "warnings_contain": "cache age"},
      "note": "wihl #1. Offline may serve a moving path from cache, but must say how old it is."
    },
    {
      "id": "latest-means-unversioned",
      "argv": ["--offline", "--format", "json", "inspect-module", "terraform-google-modules/network/google/latest"],
      "expect": {"exit": 0, "ok": true, "provider": "google", "warnings_contain": "latest"},
      "note": "wihl #2. '.../latest' is a registry 404; treat it as the unversioned path and say so."
    },
    {
      "id": "submodule-inspect",
      "argv": ["--offline", "--format", "json", "inspect-module", "terraform-aws-modules/eks/aws/21.30.2//modules/karpenter"],
      "expect": {"exit": 0, "ok": true, "data_equals": {"submodule": "modules/karpenter"}, "inputs_names_include": ["node_iam_role_name"], "inputs_names_exclude": ["launch_template_description"]},
      "note": "wihl #3. Terraform's own // syntax selects a submodule; inputs come from it, not the root or a sibling."
    },
    {
      "id": "submodule-unknown",
      "argv": ["--offline", "--format", "json", "inspect-module", "terraform-aws-modules/eks/aws/21.30.2//modules/nope"],
      "expect": {"exit": 1, "ok": false, "error_code": 1, "error_contains": "modules/karpenter"},
      "note": "wihl #3. An unknown submodule fails and lists the ones that exist."
    },
    {
      "id": "submodules-listed-in-meta",
      "argv": ["--offline", "--format", "json", "inspect-module", "terraform-aws-modules/eks/aws/21.30.2", "--fields", "meta"],
      "expect": {"exit": 0, "ok": true, "submodules_include": ["modules/eks-managed-node-group", "modules/karpenter"]}
    },
    {
      "id": "deprecation-warns",
      "argv": ["--offline", "--format", "json", "inspect-module", "example-deprecated/network/google"],
      "expect": {"exit": 0, "ok": true, "warnings_contain": "deprecated"},
      "note": "wihl #4. SYNTHETIC fixture: no deprecated module found live, and the deprecation object's shape is assumed."
    },
    {
      "id": "no-deprecation-no-warning",
      "argv": ["--offline", "--format", "json", "inspect-module", "terraform-aws-modules/eks/aws/21.30.2"],
      "expect": {"exit": 0, "ok": true, "warnings_not_contain": "deprecated"},
      "note": "wihl #4 negative control: deprecation null -> no warning."
    },
    {
      "id": "cache-key-includes-host",
      "argv": ["--host", "registry.example.invalid", "--offline", "--format", "json", "inspect-module", "terraform-google-modules/network/google"],
      "expect": {"exit": 1, "ok": false, "error_code": 1},
      "note": "A private registry must not be answered from the public registry's cache entry for the same path. The fixture is cached for the default host only, so another host is an offline miss."
    }
  ]
}
